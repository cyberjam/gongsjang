{
  "name": "gongsjang",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test",
    "seed:fetch": "node --env-file-if-exists=.env.local scripts/fetch-public-data.mjs",
    "seed:build": "node --env-file-if-exists=.env.local scripts/build-seeds.mjs",
    "seed:parks": "node --env-file-if-exists=.env.local scripts/build-parks-demo.mjs",
    "seed:eqmt": "node --env-file-if-exists=.env.local scripts/build-eqmt-demo.mjs",
    "seed:osm": "node scripts/fetch-osm.mjs",
    "seed:import": "node --env-file-if-exists=.env.local scripts/import-seeds.mjs",
    "seed:import:parks": "node --env-file-if-exists=.env.local scripts/import-seeds.mjs supabase/seeds/parks-demo.json",
    "seed:import:eqmt": "node --env-file-if-exists=.env.local scripts/import-seeds.mjs supabase/seeds/eqmt-demo.json",
    "seed:import:osm": "node --env-file-if-exists=.env.local scripts/import-seeds.mjs supabase/seeds/cheongju.osm.json",
    "seed:all": "npm run seed:eqmt && npm run seed:import eqmt && npm run seed:parks && npm run seed:import parks"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  }
}
