# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Kakao Maps JavaScript Key (도메인 등록 필수)
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key

# Kakao REST API Key (시드 지오코딩 — 주소→좌표 복구용, JS 키와 다름, 서버 전용)
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# ─── 서버 사이드 전용 (브라우저 노출 금지, NEXT_PUBLIC_ 접두사 X) ───
# data.go.kr 시드 import 스크립트용
DATA_GO_KR_API_KEY=your-data-go-kr-decoded-service-key

# Supabase service role key — seed import 시 RLS 우회용 (브라우저 노출 절대 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
